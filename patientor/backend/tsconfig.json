{
  "compilerOptions": {

    "module": "nodenext",
    "target": "esnext",
    "noEmit": true,
    "types": [],
    "strict": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "allowImportingTsExtensions": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
  }
}
